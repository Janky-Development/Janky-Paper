+    // Janky Paper start - a dimension folder without its world gen settings file must not crash the server
+    private boolean jankyHasGenSettings(final ResourceKey<Level> dimensionKey) {
+        if (dimensionKey == Level.OVERWORLD) {
+            return true;
+        }
+        final java.nio.file.Path dimensionPath = this.server.storageSource.getDimensionPath(dimensionKey);
+        if (!java.nio.file.Files.isDirectory(dimensionPath)) {
+            return false; // a dimension that was never generated gets the server's settings, like a new world
+        }
+        final java.nio.file.Path settingsFile = WorldGenSettings.TYPE.id().withSuffix(".dat").resolveAgainst(dimensionPath.resolve(LevelResource.DATA.id()));
+        if (!java.nio.file.Files.isRegularFile(settingsFile)) {
+            dev.jankypaper.server.log.JankyLog.warn("Dimension folder for " + dimensionKey.identifier() + " exists but " + settingsFile.getFileName() + " is missing - regenerating world gen settings from the server defaults");
+            return false;
+        }
+        return true;
+    }
+    // Janky Paper end
 
