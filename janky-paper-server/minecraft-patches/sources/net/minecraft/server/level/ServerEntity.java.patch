+    // Janky Paper start - entity with no viewers
+    /**
+     * The movement part of {@link #sendChanges} for an entity nobody tracks: every bot and mob far from real players
+     * built a movement packet every tick for an empty viewer set. Keeps the state a later viewer relies on - dirty
+     * entity data (also sent to a player itself), last-sent rotation / ground state, a fresh position base - and when
+     * a player starts tracking it, Paper's forced resync sends the full position on the next update.
+     */
+    private void jankySyncUnwatched(final Vec3 currentPosition) {
+        this.positionCodec.setBase(currentPosition);
+        this.lastSentYRot = Mth.packDegrees(this.entity.getYRot());
+        this.lastSentXRot = Mth.packDegrees(this.entity.getXRot());
+        this.lastSentYHeadRot = Mth.packDegrees(this.entity.getYHeadRot());
+        this.lastSentMovement = this.entity.getDeltaMovement();
+        this.wasOnGround = this.entity.onGround();
+        this.wasRiding = false;
+        this.teleportDelay = 0;
+        this.sendDirtyEntityData();
+        this.entity.needsSync = false;
+    }
+    // Janky Paper end - entity with no viewers
+
+    // Janky Paper start - distant bot updates
+    /**
+     * Whether this update of a bot is skipped because every player tracking it is further than
+     * {@code bots.distant-update-range} away: those bots send movement every {@code bots.distant-update-interval} ticks
+     * instead of every 2 (staggered by entity id so the sends spread over the ticks). A gliding bot moves too fast for
+     * that and always updates. Entity data that changed meanwhile stays dirty and goes out with the next update.
+     */
+    private boolean jankyDistantBotSkip() {
+        if (!(this.entity instanceof ServerPlayer bot) || !bot.jankyBot || bot.isFallFlying()) return false;
+        int half = dev.jankypaper.server.bot.BotPlayers.distantUpdateInterval() >> 1;
+        if (half <= 1 || ((this.tickCount >> 1) + this.entity.getId()) % half == 0) return false;
+        double rangeSq = dev.jankypaper.server.bot.BotPlayers.distantUpdateRangeSq();
+        for (final net.minecraft.server.network.ServerPlayerConnection connection : this.trackedPlayers) {
+            if (connection.getPlayer().distanceToSqr(this.entity) <= rangeSq) return false;
+        }
+        return true;
+    }
