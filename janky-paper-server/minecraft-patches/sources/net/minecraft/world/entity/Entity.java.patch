+    // Janky Paper start - inert sweep
+    /**
+     * Whether every block the entity's box covered at any end point of this tick's movements is one nothing happens in
+     * (see {@link dev.jankypaper.server.world.InertBlocks}): then {@link #checkInsideBlocks} would visit only blocks
+     * that do nothing, and the effect collector stays empty.
+     */
+    private boolean jankySweepIsInert(final List<Entity.Movement> movements) {
+        if (movements.isEmpty() || !dev.jankypaper.server.world.InertBlocks.applies(this)) return false;
+        if (this.level() instanceof ServerLevel serverLevel
+            && serverLevel.getServer().debugSubscribers().hasAnySubscriberFor(DebugSubscriptions.ENTITY_BLOCK_INTERSECTIONS)) {
+            return false;
+        }
+        double minX = Double.POSITIVE_INFINITY, minY = Double.POSITIVE_INFINITY, minZ = Double.POSITIVE_INFINITY;
+        double maxX = Double.NEGATIVE_INFINITY, maxY = Double.NEGATIVE_INFINITY, maxZ = Double.NEGATIVE_INFINITY;
+        for (final Entity.Movement movement : movements) {
+            for (int end = 0; end < 2; end++) {
+                final AABB box = this.makeBoundingBox(end == 0 ? movement.from() : movement.to());
+                minX = Math.min(minX, box.minX);
+                minY = Math.min(minY, box.minY);
+                minZ = Math.min(minZ, box.minZ);
+                maxX = Math.max(maxX, box.maxX);
+                maxY = Math.max(maxY, box.maxY);
+                maxZ = Math.max(maxZ, box.maxZ);
+            }
+        }
+        return dev.jankypaper.server.world.InertBlocks.allInert(this.level(), Mth.floor(minX), Mth.floor(minY), Mth.floor(minZ),
+            Mth.floor(maxX), Mth.floor(maxY), Mth.floor(maxZ), this.getRemainingFireTicks() <= 0); // not burning: water does nothing either
+    }
