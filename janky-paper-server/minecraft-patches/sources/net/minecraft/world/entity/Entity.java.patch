+    // Janky Paper start - parallel bot movement: block-effect hint
+    /** Set by a movement worker right after this bot's parallel move; consumed by the next {@link #applyEffectsFromBlocks()}. */
+    public boolean jankyInertHint;
+    private boolean jankyHintThisCall;
+
+    /**
+     * Movement worker thread, right after the bot's parallel travel, while the world is read-only: whether this tick's
+     * block effects can only be no-ops - every block its box swept through is inert, and the block it stands on has no
+     * {@code stepOn} reaction. Reads blocks only; the main thread then skips that work (see {@link #applyEffectsFromBlocks}).
+     */
+    public final void jankyComputeInertHint() {
+        this.jankyInertHint = false;
+        if (!this.isAffectedByBlocks() || !dev.jankypaper.server.world.InertBlocks.applies(this)) return;
+        if (this.level() instanceof ServerLevel serverLevel
+            && serverLevel.getServer().debugSubscribers().hasAnySubscriberFor(DebugSubscriptions.ENTITY_BLOCK_INTERSECTIONS)) {
+            return;
+        }
+        if (this.onGround()) {
+            final BlockState under = this.level().getBlockStateIfLoaded(this.getOnPosLegacy());
+            if (under == null || dev.jankypaper.server.world.InertBlocks.reactsToStepOn(under)) return;
+        }
+        // the movements applyEffectsFromBlocks() will use: this tick's recorded steps, or old -> current position
+        double minX = Double.POSITIVE_INFINITY, minY = Double.POSITIVE_INFINITY, minZ = Double.POSITIVE_INFINITY;
+        double maxX = Double.NEGATIVE_INFINITY, maxY = Double.NEGATIVE_INFINITY, maxZ = Double.NEGATIVE_INFINITY;
+        final java.util.Iterator<Entity.Movement> recorded = this.movementThisTick.iterator();
+        Entity.Movement step = null;
+        for (int i = 0; i < 2 || recorded.hasNext() || step != null; i++) {
+            final Vec3 point;
+            if (i == 0) {
+                point = this.oldPosition();
+            } else if (i == 1) {
+                point = this.position();
+            } else if (step != null) {
+                point = step.to(); // second end of the step read last time
+                step = null;
+            } else {
+                step = recorded.next();
+                point = step.from();
+            }
+            final AABB box = this.makeBoundingBox(point);
+            minX = Math.min(minX, box.minX);
+            minY = Math.min(minY, box.minY);
+            minZ = Math.min(minZ, box.minZ);
+            maxX = Math.max(maxX, box.maxX);
+            maxY = Math.max(maxY, box.maxY);
+            maxZ = Math.max(maxZ, box.maxZ);
+        }
+        this.jankyInertHint = dev.jankypaper.server.world.InertBlocks.allInert(this.level(), Mth.floor(minX), Mth.floor(minY), Mth.floor(minZ),
+            Mth.floor(maxX), Mth.floor(maxY), Mth.floor(maxZ), this.getRemainingFireTicks() <= 0); // not burning: water does nothing either
+    }
